# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rms

# Auth Secret — Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# Encryption Key (AES-256) — Generate with: openssl rand -hex 32
DIGILOCKER_ENCRYPTION_KEY=your_digilocker_encryption_key_here

# AI Operational Co-Pilot API Keys
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=AIzaSy_your_gemini_key

# Nodemailer / Gmail SMTP Transporter Credentials
SMTP_EMAIL=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# UPI Payment Configuration
NEXT_PUBLIC_UPI_ID=your-upi-id@bank
NEXT_PUBLIC_UPI_NAME=Lease360 Rentals
